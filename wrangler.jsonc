{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "backend-cloudflare",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "JWT_SECRET": "your-very-secret-key-change-this-in-production",
    "GOOGLE_CLIENT_ID": "",
    "GOOGLE_CLIENT_SECRET": "",
    "FRONTEND_URL": "http://localhost:8081",
    "ENABLE_ADMIN": "true"
  },
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID",
      "preview_id": "REPLACE_WITH_YOUR_KV_PREVIEW_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MY_BUCKET",
      "bucket_name": "ielts-assets"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ielts_db",
      "database_id": "YOUR_D1_DATABASE_ID",
      "migrations_dir": "drizzle"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "queues": {
    "producers": [
      {
        "binding": "SCORING_QUEUE",
        "queue": "scoring-queue"
      },
      {
        "binding": "SPEAKING_QUEUE",
        "queue": "speaking-queue"
      },
      {
        "binding": "EMAIL_QUEUE",
        "queue": "email-queue"
      }
    ],
    "consumers": [
      {
        "queue": "scoring-queue",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3
      },
      {
        "queue": "speaking-queue",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3
      },
      {
        "queue": "email-queue",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3
      }
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": [
      "0 0 * * *",
      "0 9 * * 1"
    ]
  }
}